{
  "title": "NAKHEL node health",
  "description": "Generated from web/lib/schemas/ingest.ts; do not edit.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255,
      "description": "The node's 1-byte LoRa ID"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$",
      "description": "When the node sent the heartbeat"
    },
    "battery_mv": {
      "description": "Battery voltage in millivolts",
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    },
    "rssi_dbm": {
      "description": "Received signal strength in dBm",
      "type": "integer",
      "minimum": -200,
      "maximum": 20
    },
    "uptime_s": {
      "description": "Seconds since the node booted",
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "node_id",
    "timestamp"
  ],
  "additionalProperties": false
}
