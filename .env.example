# Copy to .env (`make env` does this). Development values only; never commit .env.
# Passwords must be URL-safe: they are placed inside connection URLs.
POSTGRES_SUPERUSER_PASSWORD=dev_superuser_pw
NAKHEL_OWNER_PASSWORD=dev_owner_pw
NAKHEL_WEB_PASSWORD=dev_web_pw
NAKHEL_WORKER_PASSWORD=dev_worker_pw
# Host port for the dev database. 5433 because 5432 is often already taken.
NAKHEL_DB_PORT=5433
NAKHEL_DB_TEST_PORT=5434
# Password given to every account created by tools/seed.py (dev data only).
SEED_USER_PASSWORD=nakhel-dev-password
# Postgres cache size.
NAKHEL_DB_SHARED_BUFFERS=512MB
# Host port for the web app.
NAKHEL_WEB_PORT=3100
# 0.0.0.0 makes the web app reachable from outside this machine. Leave as 127.0.0.1 in development.
NAKHEL_WEB_BIND=127.0.0.1
# Signs login sessions. Use a long random value in production: openssl rand -base64 48
SESSION_SECRET=dev-only-session-secret-change-me-in-production-0000
# Sites allowed to send state-changing requests, comma separated. https only in production:
# any http:// entry turns off the cookie's Secure flag.
APP_ORIGIN=http://127.0.0.1:3100,http://localhost:3100
# Where email links point.
APP_BASE_URL=http://127.0.0.1:3100
# Mail server. Mailpit catches everything in development; its inbox is http://127.0.0.1:8026
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=false
EMAIL_FROM=NAKHEL Alerts <alerts@nakhel.local>
